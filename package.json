{
	"name": "hono-drizzle-boilerplate",
	"private": true,
	"version": "0.1.0",
	"author": "Malenquilla",
	"type": "module",
	"cloudflare": {
		"label": "",
		"products": [
			"Workers",
			"R2"
		],
		"categories": [
			"lms"
		]
	},
	"packageManager": "pnpm@10.21.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"format-and-lint": "biome check",
		"format-and-lint:fix": "biome check --write",
		"prepare": "husky",
		"pre-commit": "lint-staged",
		"cf-typegen": "wrangler types",
		"check": "tsc && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev --remote",
		"secrets": "wrangler secret bulk < secrets.json",
		"auth:generate": "NODE_ENV=local pnpm dlx @better-auth/cli@latest generate --config ./better-auth.config.ts --output ./src/database/drizzle/schemas/auth.ts --y",
		"db": "drizzle-kit",
		"db:stg": "dotenv -e .env.stg -- drizzle-kit"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.1.4",
		"@libsql/client": "^0.15.15",
		"@scalar/hono-api-reference": "^0.9.46",
		"bcryptjs": "^3.0.3",
		"better-auth": "^1.3.34",
		"drizzle-orm": "1.0.0-beta.15-859cf75",
		"hono": "^4.12.3",
		"lodash": "^4.17.21",
		"stoker": "^2.0.1",
		"uuidv7": "^1.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@commitlint/cli": "^20.3.1",
		"@commitlint/config-conventional": "^20.3.1",
		"@types/lodash": "^4.17.20",
		"@types/node": "^25.9.1",
		"dotenv": "^17.2.3",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "1.0.0-beta.15-859cf75",
		"drizzle-seed": "1.0.0-beta.15-859cf75",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.21.0",
		"typescript": "5.8.3",
		"wrangler": "4.45.4"
	}
}
